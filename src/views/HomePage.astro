---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import About from '@/components/sections/About.astro';
import Projects from '@/components/sections/Projects.astro';
import Experience from '@/components/sections/Experience.astro';
import Contact from '@/components/sections/Contact.astro';
import { site, type SectionName } from '@/config/site';
import type { Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// 섹션 이름 → 컴포넌트. 새 섹션을 만들면 여기에 등록하고 site.ts 의 homeSections 에 추가하세요.
const sectionMap: Record<SectionName, any> = {
  hero: Hero,
  about: About,
  projects: Projects,
  experience: Experience,
  contact: Contact,
};
---

<BaseLayout lang={lang}>
  <div class="container">
    {
      site.homeSections.map((name) => {
        const Section = sectionMap[name];
        return <Section lang={lang} />;
      })
    }
  </div>
</BaseLayout>
