---
import SocialLinks from './SocialLinks.astro';
import { type Lang } from '@/i18n/ui';
import { getProfile } from '@/i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const profile = await getProfile(lang);
---

<footer class="container">
  <div class="footer">
    <SocialLinks lang={lang} links={profile.data.links} size="sm" />
  </div>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    align-items: center;
    padding-block: 2rem;
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
</style>
