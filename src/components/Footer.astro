---
import SocialLinks from './SocialLinks.astro';
import { type Lang } from '@/i18n/ui';
import { getProfile, localizePath, useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const profile = await getProfile(lang);
const year = new Date().getFullYear();
---

<footer class="container">
  <div class="footer">
    <div class="left">
      <span>© {year} {profile.data.name}</span>
      <SocialLinks lang={lang} links={profile.data.links} size="sm" />
      <a href={localizePath(lang, '/rss.xml')} class="rss">{t('writing.rss')}</a>
    </div>
    <span>{t('footer.builtWith')}</span>
  </div>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    justify-content: space-between;
    padding-block: 2rem;
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .left {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    align-items: center;
  }
</style>
