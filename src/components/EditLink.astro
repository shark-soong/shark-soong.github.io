---
/**
 * "수정" 버튼 — 누르면 /admin/ 관리 화면에서 이 글(항목)을 바로 엽니다.
 * 이 브라우저에서 /admin/ 에 로그인한 적이 있을 때만 보입니다 (다른 방문자에게는 안 보임).
 * 로그인하지 않았어도 주소 끝에 ?edit 를 붙이면 보입니다. 보이게 하는 스크립트는 BaseLayout 에 있습니다.
 *
 * collection: public/admin/config.yml 의 컬렉션 이름 (writing, projects, history, pages)
 * entry: 파일 이름 (언어 폴더·확장자 제외). 예: 2026-11-16-제목, now
 */
import type { Lang } from '@/i18n/ui';
import { defaultLang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
  collection: string;
  entry: string;
  /** 실제 내용의 언어 (번역이 없어 한국어 원문을 보여줄 때는 ko) */
  contentLang?: Lang;
  size?: 'sm' | 'md';
}
const { lang, collection, entry, contentLang = lang, size = 'md' } = Astro.props;
const t = useTranslations(lang);
const locale = contentLang === defaultLang ? '' : `?_locale=${contentLang}`;
const href = `/admin/#/collections/${collection}/entries/${encodeURIComponent(entry)}${locale}`;
---

<a href={href} class:list={['edit-link', size]} data-edit-link hidden>{t('edit.label')}</a>


<style>
  .edit-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 32px;
    padding: 0 0.75rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-soft);
    background: var(--color-bg);
  }
  .edit-link.md {
    min-height: 36px;
    margin-top: 1.5rem;
    font-size: var(--text-sm);
  }
  .edit-link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .edit-link[hidden] {
    display: none;
  }
</style>
