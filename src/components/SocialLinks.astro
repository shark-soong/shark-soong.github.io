---
import type { Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
  links: { github?: string; linkedin?: string; email?: string; x?: string };
  resume?: string;
  size?: 'md' | 'sm';
}
const { lang, links, resume, size = 'md' } = Astro.props;
const t = useTranslations(lang);

// 표시 순서는 여기서 조정
const items = [
  links.github && { href: links.github, label: 'GitHub', external: true },
  links.linkedin && { href: links.linkedin, label: 'LinkedIn', external: true },
  links.x && { href: links.x, label: 'X', external: true },
  links.email && { href: `mailto:${links.email}`, label: 'Email', external: false },
  resume && { href: resume, label: t('nav.resume'), external: false },
].filter((i): i is { href: string; label: string; external: boolean } => Boolean(i));
---

<ul class:list={['links', size]}>
  {
    items.map((i) => (
      <li>
        <a href={i.href} rel={i.external ? 'me noopener' : undefined}>
          {i.label}
          {i.external && <span aria-hidden="true"> ↗</span>}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
    font-weight: 500;
  }
  .links.sm {
    margin: 0;
    gap: 0.5rem 1.25rem;
    font-size: var(--text-sm);
    font-weight: 400;
  }
  .md a {
    display: inline-block;
    padding-bottom: 2px;
    border-bottom: 2px solid currentColor;
  }
</style>
