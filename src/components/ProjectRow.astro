---
import type { LocalizedProject } from '@/i18n/utils';
import { localizePath } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
  project: LocalizedProject;
}
const { lang, project } = Astro.props;
const { data } = project.entry;
const period = data.period ?? data.date?.getFullYear().toString();
// 제목 아래 한 줄: 기간 · 역할 · 태그
const meta = [period, data.role, ...data.tags].filter(Boolean).join(' · ');
---

<li class="row">
  <h3><a href={localizePath(lang, `/projects/${project.slug}/`)}>{data.title}</a></h3>
  <p class="summary">{data.summary}</p>
  {meta && <p class="meta">{meta}</p>}
</li>

<style>
  .row {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-block: 2.25rem;
    border-top: 1px solid var(--color-border);
  }
  .row:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .row:last-child {
    padding-bottom: 0;
  }
  h3 {
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }
  .summary {
    max-width: 40rem;
    line-height: 1.7;
    color: var(--color-text-soft);
    text-wrap: pretty;
  }
  .meta {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
</style>
