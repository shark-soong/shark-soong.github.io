---
/** 왼쪽에 라벨, 오른쪽에 내용이 오는 2단 섹션 틀 (좁은 화면에서는 위아래로 쌓임) */
interface Props {
  id: string;
  label: string;
}
const { id, label } = Astro.props;
---

<section id={id} class="split">
  <h2 class="label">{label}</h2>
  <div class="body"><slot /></div>
</section>

<style>
  .split {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem 3rem;
    padding-block: var(--section-y);
    border-bottom: 1px solid var(--color-border);
  }
  .label {
    flex: 1 1 12.5rem;
  }
  .body {
    flex: 999 1 35rem;
    min-width: 0;
  }
</style>
