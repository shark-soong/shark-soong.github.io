---
/**
 * 왼쪽에 라벨(+ "전체 보기" 링크), 오른쪽에 내용이 오는 2단 섹션 틀.
 * 좁은 화면에서는 위아래로 쌓입니다. 단 비율은 global.css 의 .cols 에서 정합니다.
 */
interface Props {
  id: string;
  label: string;
  moreHref?: string;
  moreLabel?: string;
}
const { id, label, moreHref, moreLabel } = Astro.props;
---

<section id={id} class="split cols">
  <div class="side head">
    <h2 class="label">{label}</h2>
    {moreHref && moreLabel && <a href={moreHref} class="more">{moreLabel}</a>}
  </div>
  <div class="main"><slot /></div>
</section>

<style>
  .split {
    padding-block: var(--section-y);
    border-top: 1px solid var(--color-border);
  }
  .head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
  }
  .more {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 5px;
  }
</style>
