---
import type { LocalizedPost } from '@/i18n/utils';
import { formatDate, localizePath, useTranslations } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
  post: LocalizedPost;
}
const { lang, post } = Astro.props;
const t = useTranslations(lang);
const { data } = post.entry;
const contentLang = post.isFallback ? post.contentLang : undefined;
---

<li class="row">
  <p class="date">
    <time datetime={data.date.toISOString()}>{formatDate(data.date, lang)}</time>
    {post.isFallback && <span class="badge"> · {t('fallback.badge')}</span>}
  </p>
  <h3 lang={contentLang}><a href={localizePath(lang, `/writing/${post.slug}/`)}>{data.title}</a></h3>
  <p class="desc" lang={contentLang}>{data.description}</p>
</li>

<style>
  .row {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-block: 2.25rem;
    border-top: 1px solid var(--color-border);
  }
  .row:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .row:last-child {
    padding-bottom: 0;
  }
  .date {
    font-size: var(--text-sm);
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }
  h3 {
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }
  .desc {
    max-width: 40rem;
    line-height: 1.7;
    color: var(--color-text-soft);
    text-wrap: pretty;
  }
</style>
