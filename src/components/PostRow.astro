---
import type { LocalizedPost } from '@/i18n/utils';
import { formatDate, localizePath, useTranslations } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
  post: LocalizedPost;
}
const { lang, post } = Astro.props;
const t = useTranslations(lang);
const { data } = post.entry;
---

<li class="row">
  <a href={localizePath(lang, `/writing/${post.slug}/`)}>
    <time datetime={data.date.toISOString()}>{formatDate(data.date, lang)}</time>
    <span class="title" lang={post.isFallback ? post.contentLang : undefined}>
      {data.title}
      {post.isFallback && <span class="badge" lang={lang}>{t('fallback.badge')}</span>}
    </span>
  </a>
</li>

<style>
  .row {
    border-top: 1px solid var(--color-border);
  }
  a {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    align-items: baseline;
    padding-block: 1.125rem;
  }
  time {
    flex: 0 0 9rem;
    font-size: 0.9375rem;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }
  .title {
    flex: 1 1 20rem;
    min-width: 0;
    font-size: 1.1875rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .badge {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-muted);
    vertical-align: 0.2em;
  }
</style>
