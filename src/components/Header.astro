---
import LangSwitch from './LangSwitch.astro';
import { type Lang } from '@/i18n/ui';
import { localizePath, useTranslations } from '@/i18n/utils';
import { site } from '@/config/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const home = localizePath(lang, '/');

// 메뉴 항목 — 추가/삭제/순서 변경은 여기서
const items = [
  { href: `${home}#about`, label: t('nav.about') },
  { href: localizePath(lang, '/projects/'), label: t('nav.projects') },
  { href: `${home}#experience`, label: t('nav.experience') },
  { href: `${home}#contact`, label: t('nav.contact') },
];
---

<header class="container header">
  <a href={home} class="logo">{site.handle}</a>
  <nav aria-label={t('nav.mainLabel')} class="nav">
    {items.map((item) => <a href={item.href}>{item.label}</a>)}
    <LangSwitch lang={lang} />
  </nav>
</header>

<style>
  .header {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    align-items: center;
    padding-block: 2rem;
  }
  .logo {
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: -0.01em;
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
    align-items: center;
    font-size: 0.9375rem;
  }
</style>
