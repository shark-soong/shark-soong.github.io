---
import LangSwitch from './LangSwitch.astro';
import { site } from '@/config/site';
import { type Lang } from '@/i18n/ui';
import { getPages, getProfile, localizePath, useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const profile = await getProfile(lang);
const navPages = (await getPages(lang))
  .filter((p) => p.entry.data.nav)
  .sort((a, b) => a.entry.data.navOrder - b.entry.data.navOrder);

// 메뉴 항목 — 고정 메뉴는 여기서, 단독 페이지는 pages/*.md 의 nav: true 로 추가
const items = [
  { href: localizePath(lang, '/writing/'), label: t('nav.writing') },
  { href: localizePath(lang, '/projects/'), label: t('nav.projects') },
  { href: localizePath(lang, '/history/'), label: t('nav.history') },
  ...navPages.map((p) => ({ href: localizePath(lang, `/${p.slug}/`), label: p.entry.data.title })),
  ...(profile.data.resume ? [{ href: profile.data.resume, label: t('nav.resume') }] : []),
];
const current = Astro.url.pathname;
---

<header class="container header">
  <a href={localizePath(lang, '/')} class="logo">{site.brand}</a>
  <nav aria-label={t('nav.mainLabel')} class="nav">
    {
      items.map((item) => (
        <a href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
    <LangSwitch lang={lang} />
  </nav>
</header>

<style>
  .header {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    align-items: center;
    padding-block: 1.5rem;
  }
  .logo {
    padding-block: 0.75rem;
    font-weight: 700;
    font-size: 1.0625rem;
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    align-items: center;
    font-size: 0.9375rem;
  }
  .nav > a[aria-current='page'] {
    color: var(--color-accent);
  }
</style>
