---
import ProjectRow from '@/components/ProjectRow.astro';
import SplitSection from '@/components/SplitSection.astro';
import { site } from '@/config/site';
import { type Lang } from '@/i18n/ui';
import { getProjects, localizePath, useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const all = await getProjects(lang);
// featured: true 를 먼저, 부족하면 최신순으로 채움
const featured = [
  ...all.filter((p) => p.entry.data.featured),
  ...all.filter((p) => !p.entry.data.featured),
].slice(0, site.featuredLimit);
// 홈에 다 보여주지 못한 프로젝트가 있을 때만 "전체 프로젝트 →" 링크를 답니다.
const hasMore = all.length > featured.length;
---

<SplitSection
  id="projects"
  label={t('section.projects')}
  moreHref={hasMore ? localizePath(lang, '/projects/') : undefined}
  moreLabel={t('projects.all')}
>
  <ul class="list">
    {featured.map((project) => <ProjectRow lang={lang} project={project} />)}
  </ul>
</SplitSection>

<style>
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
