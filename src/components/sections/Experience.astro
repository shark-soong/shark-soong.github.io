---
/**
 * 타임라인 — 학력·경력·활동을 세로 선 위에 한 줄씩 보여줍니다.
 * 홈 첫 화면(Intro)의 오른쪽 단에 들어갑니다.
 * 항목은 src/content/experience/<언어>/*.yaml 파일 하나가 한 줄입니다.
 * end 가 없는(= 현재 진행 중인) 항목은 강조색으로 표시됩니다.
 */
import { type Lang, type UiKey } from '@/i18n/ui';
import { getExperience, useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const items = await getExperience(lang);
---

<div id="experience" class="timeline">
  <h2 class="label fade-up" style="--delay: 0.15s">{t('section.experience')}</h2>
  <div class="track">
    <span class="line" aria-hidden="true"></span>
    <ol class="list">
      {
        items.map(({ data }, i) => (
          <li class:list={['item', 'fade-up', { current: !data.end }]} style={`--delay: ${(0.3 + i * 0.15).toFixed(2)}s`}>
            <span class="dot" aria-hidden="true" />
            <div class="body">
              <p class="when">
                {data.start} — {data.end ?? t('experience.present')} · {t(`experience.kind.${data.kind}` as UiKey)}
              </p>
              <h3>
                {data.org} · {data.role}
              </h3>
              {data.description && <p class="desc">{data.description}</p>}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</div>

<style>
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .track {
    position: relative;
  }
  /* 세로 선: 처음 열 때 위에서 아래로 그려집니다 */
  .line {
    position: absolute;
    left: 4px;
    top: 0.75rem;
    bottom: 0.75rem;
    width: 1px;
    background: var(--color-border-strong);
    transform-origin: center top;
    animation: draw-down 1.2s cubic-bezier(0.6, 0, 0.2, 1) 0.3s both;
  }
  @keyframes draw-down {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }
  .list {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .item {
    position: relative;
    display: flex;
    gap: 2rem;
  }
  .dot {
    position: relative;
    flex: 0 0 9px;
    height: 9px;
    margin-top: 0.5rem;
    border-radius: 50%;
    background: var(--color-text);
    outline: 4px solid var(--color-bg);
  }
  .body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .when {
    font-size: var(--text-sm);
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }
  h3 {
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }
  .desc {
    line-height: 1.7;
    color: var(--color-text-soft);
  }
  .current .dot {
    background: var(--color-accent);
  }
  .current .when {
    font-weight: 500;
    color: var(--color-accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .line {
      animation: none;
    }
  }
</style>
