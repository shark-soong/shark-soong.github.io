---
import { render } from 'astro:content';
import SocialLinks from '@/components/SocialLinks.astro';
import Experience from '@/components/sections/Experience.astro';
import { type Lang } from '@/i18n/ui';
import { getProfile, useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const profile = await getProfile(lang);
const { data } = profile;
const { Content } = await render(profile);

// "마지막 업데이트"는 사이트를 빌드한 달입니다. main 에 push 할 때마다 자동으로 바뀝니다.
const builtAt = new Date();
const parts = new Intl.DateTimeFormat('en-CA', { year: 'numeric', month: '2-digit', timeZone: 'Asia/Seoul' }).formatToParts(builtAt);
const updated = `${parts.find((p) => p.type === 'year')?.value}.${parts.find((p) => p.type === 'month')?.value}`;
---

<!-- 홈 첫 화면: 왼쪽에 소개, 오른쪽에 타임라인 -->
<section id="top" class="intro cols">
  <div class="side profile fade-up">
    <h1>{data.name}</h1>
    <p class="role">{data.role}{data.location && <span class="loc"> · {data.location}</span>}</p>
    <div class="bio">
      <Content />
    </div>
    <SocialLinks lang={lang} links={data.links} resume={data.resume} />
    <p class="meta">
      {t('page.updated')} <time datetime={builtAt.toISOString()}>{updated}</time>
    </p>
  </div>
  <div class="main">
    <Experience lang={lang} />
  </div>
</section>

<style>
  .intro {
    padding-block: 4.5rem 5.5rem;
    row-gap: 4rem;
  }
  .profile {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  h1 {
    font-size: clamp(3rem, 5.5vw, 4.5rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    font-weight: 700;
  }
  .role {
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--color-accent);
  }
  .loc {
    color: var(--color-muted);
  }
  .bio {
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--color-text-soft);
    text-wrap: pretty;
  }
  .bio :global(p + p) {
    margin-top: 1.25rem;
  }
  .bio :global(a) {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .bio :global(a:hover) {
    color: var(--color-accent);
  }
  .meta {
    font-size: var(--text-sm);
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 640px) {
    .intro {
      padding-block: 3rem 3.5rem;
      row-gap: 3rem;
    }
  }
</style>
