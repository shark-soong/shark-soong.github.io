---
import { render } from 'astro:content';
import SocialLinks from '@/components/SocialLinks.astro';
import { type Lang } from '@/i18n/ui';
import { getProfile, useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const profile = await getProfile(lang);
const { data } = profile;
const { Content } = await render(profile);
---

<section id="top" class="intro">
  <h1>{data.name}</h1>
  <p class="role">{data.role}{data.location && <span class="loc"> · {data.location}</span>}</p>
  <div class="bio">
    <Content />
  </div>
  <SocialLinks lang={lang} links={data.links} resume={data.resume} />
  {
    data.skills.length > 0 && (
      <div class="skills">
        <h2 class="visually-hidden">{t('section.skills')}</h2>
        <ul>
          {data.skills.map((s) => (
            <li class="chip">{s}</li>
          ))}
        </ul>
      </div>
    )
  }
</section>

<style>
  .intro {
    padding-block: 6rem 5rem;
    border-bottom: 1px solid var(--color-border);
  }
  h1 {
    font-size: clamp(2.5rem, 5.5vw, 4rem);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
    font-weight: 700;
  }
  .role {
    margin-top: 1rem;
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--color-accent);
  }
  .loc {
    color: var(--color-muted);
  }
  .bio {
    margin-top: 2rem;
    max-width: 42rem;
    font-size: var(--text-lg);
    line-height: 1.7;
    color: var(--color-text-soft);
  }
  .bio :global(p + p) {
    margin-top: 1em;
  }
  .bio :global(a) {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: 4px;
    text-decoration-thickness: 1.5px;
  }
  .bio :global(a:hover) {
    color: var(--color-accent);
    text-decoration-color: currentColor;
  }
  .skills ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }
  @media (max-width: 640px) {
    .intro {
      padding-block: 3.5rem;
    }
  }
</style>
