---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { defaultLang } from '@/i18n/ui';
import { localizePath, useTranslations } from '@/i18n/utils';

const lang = defaultLang;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title="404">
  <section class="container nf">
    <p class="code">404</p>
    <h1>{t('404.title')}</h1>
    <p class="en" lang="en">Page not found</p>
    <div class="actions">
      <a href={localizePath('ko', '/')} class="btn btn--solid">{t('404.home')}</a>
      <a href={localizePath('en', '/')} class="btn" lang="en">Home (EN)</a>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding-block: 8rem;
  }
  .code {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-accent);
  }
  h1 {
    margin-top: 1rem;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    letter-spacing: var(--tracking-display);
  }
  .en {
    margin-top: 0.5rem;
    color: var(--color-muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }
</style>
