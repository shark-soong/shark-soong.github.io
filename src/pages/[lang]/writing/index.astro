---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostRow from '@/components/PostRow.astro';
import { langs, type Lang } from '@/i18n/ui';
import { getPosts, localizePath, useTranslations } from '@/i18n/utils';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const posts = await getPosts(lang);

// 연도별로 묶기
const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const y = Number(post.entry.data.date.toLocaleString('en-US', { year: 'numeric', timeZone: 'Asia/Seoul' }));
  byYear.set(y, [...(byYear.get(y) ?? []), post]);
}
---

<BaseLayout lang={lang} title={t('writing.pageTitle')} description={t('writing.pageIntro')}>
  <div class="container">
    <header class="head">
      <h1>{t('writing.pageTitle')}</h1>
      <p>{t('writing.pageIntro')} <a href={localizePath(lang, '/rss.xml')} class="rss">{t('writing.rss')}</a></p>
    </header>
    {posts.length === 0 && <p class="empty">{t('writing.empty')}</p>}
    {
      [...byYear].map(([year, items]) => (
        <section class="year">
          <h2 class="label">{year}</h2>
          <ul class="list">
            {items.map((post) => (
              <PostRow lang={lang} post={post} />
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .head {
    padding-block: 5rem 3rem;
  }
  h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-tight);
  }
  .head p {
    margin-top: 1.25rem;
    font-size: var(--text-lg);
    color: var(--color-text-soft);
  }
  .rss {
    margin-left: 0.5rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
  }
  .empty {
    padding-bottom: var(--section-y);
    color: var(--color-muted);
  }
  .year {
    padding-bottom: 3rem;
  }
  .year .label {
    margin-bottom: 0.75rem;
  }
  .list {
    margin: 0;
    padding: 2.25rem 0 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }
  .year:last-child {
    padding-bottom: var(--section-y);
  }
</style>
