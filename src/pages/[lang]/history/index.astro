---
/** 이력 페이지: src/content/history/<언어>/*.yaml 을 학년도별로 묶어 최신 연도부터 보여줍니다. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import HistoryEntry from '@/components/HistoryEntry.astro';
import { langs, type Lang } from '@/i18n/ui';
import { getHistoryByYear, useTranslations } from '@/i18n/utils';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const years = await getHistoryByYear(lang);
const hasFallback = years.some((y) => y.items.some((i) => i.isFallback));
---

<BaseLayout lang={lang} title={t('history.pageTitle')} description={t('history.pageIntro')}>
  <div class="container">
    <header class="head">
      <h1>{t('history.pageTitle')}</h1>
      <p>{t('history.pageIntro')}</p>
      {hasFallback && <p class="notice" role="note">{t('fallback.notice')}</p>}
      <nav class="jump" aria-label={t('history.pageTitle')}>
        {years.map((y) => <a href={`#y${y.year}`}>{y.year}</a>)}
      </nav>
    </header>

    {
      years.map((y) => (
        <section id={`y${y.year}`} class="year cols">
          <div class="side">
            <h2 class="year-num">{y.year}</h2>
            {y.stage && <p class="stage">{y.stage}</p>}
          </div>
          <ul class="main list">
            {y.items.map((item) => (
              <HistoryEntry lang={lang} item={item} />
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .head {
    padding-block: 5rem 3rem;
  }
  h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-tight);
  }
  .head > p {
    margin-top: 1.25rem;
    max-width: 40rem;
    font-size: var(--text-lg);
    color: var(--color-text-soft);
  }
  .head > .notice {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin-top: 2rem;
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
  }
  .jump a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-color: var(--color-border-strong);
  }
  .year {
    padding-block: var(--section-y);
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 1rem;
  }
  .year:last-of-type {
    padding-bottom: calc(var(--section-y) * 1.5);
  }
  .side {
    position: sticky;
    top: 1.5rem;
  }
  .year-num {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .stage {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    color: var(--color-accent);
    font-weight: 500;
  }
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (max-width: 760px) {
    .side {
      position: static;
    }
  }
</style>
